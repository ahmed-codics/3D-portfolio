---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Browser from '../components/Browser.astro';
import CopyEmail from '../components/CopyEmail.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { kavvi, fmt } from '../data/stats';
import { experience, education } from '../data/experience';
import { skills } from '../data/skills';
import kavviLanding from '../assets/work/kavvi/landing-en.png';
import kavviPoster from '../assets/work/kavvi/launch-poster.jpg';
import rcSite from '../assets/work/rc-website.png';
import bahrawy from '../assets/work/bahrawy.png';

const rcProducts = [
  ['Company website', 'Public site with a blog and content admin', 'Live'],
  ['HR / CRM system', 'Role-based access, lead pipeline, HR workflows', 'Live'],
  ['RoboConnect', 'Marketplace for robotics work, with escrow payments', 'Ready'],
  ['ConnectedLabs', 'Remote SSH access to physical robots', 'Ready'],
  ['RoboAgent', 'Agentic coding for robotics, plus its web platform', 'Beta'],
];
---
<Base
  title="Ahmed Mansour: AI & Full-Stack Engineer"
  description={`I build AI products and ship them to real users. I built and launched Kavvi, an AI study platform, on my own: ${kavvi.students} students in its first two weeks. Open to remote roles.`}
>
  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-text">
        <p class="label label--accent eyebrow"><span class="dot" aria-hidden="true"></span>AI & full-stack engineer · Cairo (UTC+3) · Open to remote roles</p>
        <h1>I build AI products and ship them to real users.</h1>
        <p class="lead">
          I designed, built and launched <a href="/kavvi">Kavvi</a>, an AI study platform for Egyptian university students,
          on my own. It reached {fmt(kavvi.students)} students, {fmt(kavvi.lessons)} AI-built lessons and its first paying
          customers in two weeks. Before that, I took five products from prototype to production-ready at Robotics Corner.
        </p>
        <div class="cta">
          <a class="btn btn--primary" href="/kavvi">Read the Kavvi case study <Icon name="arrow" /></a>
          <a class="btn" href={profile.cv}><Icon name="download" />Download CV (PDF)</a>
        </div>
        <CopyEmail />
      </div>

      <aside class="sheet" aria-labelledby="sheet-title">
        <div class="sheet-head">
          <span class="label" id="sheet-title">Key figures</span>
          <span class="label">As of {kavvi.asOf}</span>
        </div>
        <div class="spec spec--2">
          <div><span class="label">Kavvi students</span><b>{fmt(kavvi.students)}</b></div>
          <div><span class="label">Lessons generated</span><b>{fmt(kavvi.lessons)}</b></div>
          <div><span class="label">Paying customers</span><b>{kavvi.payers}</b></div>
          <div><span class="label">Products shipped at RC</span><b>5</b></div>
        </div>
        <p class="spec-note">Kavvi launched {kavvi.launched}. RC = Robotics Corner, Jan–Oct 2026.</p>
      </aside>
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section-head">
        <p class="label">01 / Selected work</p>
        <h2 id="work-title">Products I built and shipped</h2>
      </div>

      <article class="card card--feature">
        <div class="card-text">
          <p class="label">Founder · solo engineer · Oct 2025 – now</p>
          <h3>Kavvi: an AI study platform</h3>
          <p>
            Students upload their own lectures and Kavvi turns them into lessons, practice and a study plan, explained in
            English or Egyptian Arabic. I built every part of it and run it in production.
          </p>
          <ul class="ticks">
            <li>Turns lecture PDFs and slides into lessons, practice and study plans.</li>
            <li>Photo answer cards: every question is solved twice and checked.</li>
            <li>Payments, plans and production ops, all built and run by me.</li>
          </ul>
          <ul class="chips" aria-label="Stack">
            <li>React</li><li>Node.js</li><li>Python</li><li>MongoDB</li><li>LLMs & RAG</li><li>Docker</li>
          </ul>
          <p class="links">
            <a href="/kavvi">Case study <Icon name="arrow" /></a>
            <a href="https://kavvi.io">kavvi.io <Icon name="external" /></a>
          </p>
        </div>
        <div class="feature-media">
          <Browser src={kavviLanding} url="kavvi.io" alt="Kavvi's landing page: “Your next ‘I get it.’” with a chat box to start a subject." sizes="(min-width: 960px) 560px, 92vw" eager />
          <div class="phone feature-phone">
            <Picture src={kavviPoster} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[270, 540]} sizes="160px" alt="A frame from Kavvi's launch video: a subject split into 7 lessons and 21 concepts." />
          </div>
        </div>
      </article>

      <article class="card card--split">
        <div class="card-text">
          <p class="label">Software engineer · Jan – Oct 2026</p>
          <h3>Robotics Corner: five products, one shared database and single sign-on</h3>
          <p>I was handed prototypes that didn't work and took five of them to deploy-ready. The website and HR/CRM went live; the rest are waiting on payment-gateway approval.</p>
          <dl class="products">
            {rcProducts.map(([name, what, status]) => (
              <div><dt>{name}</dt><dd>{what}</dd><dd class:list={['status', status.toLowerCase()]}>{status}</dd></div>
            ))}
          </dl>
          <p class="links">
            <a href="/robotics-corner">Case study <Icon name="arrow" /></a>
            <a href="https://roboticscorner.tech">roboticscorner.tech <Icon name="external" /></a>
            <a href="https://roboagentweb.vercel.app">RoboAgent <Icon name="external" /></a>
          </p>
        </div>
        <Browser src={rcSite} url="roboticscorner.tech" alt="The Robotics Corner website home page." sizes="(min-width: 960px) 520px, 92vw" />
      </article>

      <article class="card card--split card--flip">
        <div class="card-text">
          <p class="label">Freelance · built alone · live</p>
          <h3>El-Bahrawy: an English-learning platform for a teacher</h3>
          <p>Lessons by grade (7–12), videos, practice after each concept, quizzes, PDF material, progress tracking and student accounts, with a staff admin and a background worker behind it.</p>
          <ul class="chips" aria-label="Stack">
            <li>Next.js</li><li>NestJS</li><li>PostgreSQL</li><li>Prisma</li><li>TypeScript</li>
          </ul>
          <p class="links">
            <a href="https://el-bahrawy.com">el-bahrawy.com <Icon name="external" /></a>
            <a href="https://github.com/ahmed-codics/bahrawy">Source <Icon name="github" /></a>
          </p>
        </div>
        <Browser src={bahrawy} url="el-bahrawy.com" alt="The El-Bahrawy platform home page in Arabic." sizes="(min-width: 960px) 520px, 92vw" />
      </article>

      <article class="card card--row">
        <p class="label">Freelance · live</p>
        <h3>Abnaa Hamdallah</h3>
        <p>A management system for a sanitary-ware store, built and deployed for the owner. Private, so no public link.</p>
      </article>
    </div>
  </section>

  <section class="section" id="experience" aria-labelledby="exp-title">
    <div class="wrap">
      <div class="section-head">
        <p class="label">02 / Experience</p>
        <h2 id="exp-title">Where I've worked</h2>
      </div>
      <ol class="timeline">
        {experience.map((job) => (
          <li>
            <p class="when label">{job.when}</p>
            <div>
              <h3>{job.role} <span class="org">· {job.href ? <a href={job.href}>{job.org}</a> : job.org}, {job.where}</span></h3>
              <ul>{job.points.map((p) => <li>{p}</li>)}</ul>
              {job.more && <p class="links"><a href={job.more.href}>{job.more.label} <Icon name="arrow" /></a></p>}
            </div>
          </li>
        ))}
        <li>
          <p class="when label">{education.when}</p>
          <div>
            <h3>{education.degree} <span class="org">· {education.school}</span></h3>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="skills-title">
    <div class="wrap">
      <div class="section-head">
        <p class="label">03 / Skills</p>
        <h2 id="skills-title">What I work with</h2>
      </div>
      <dl class="skills">
        {skills.map((s) => (<div><dt>{s.group}</dt><dd>{s.items}</dd></div>))}
      </dl>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="wrap about">
      <div class="section-head">
        <p class="label">04 / About</p>
        <h2 id="about-title">A student who ships</h2>
      </div>
      <div class="about-grid">
        <div class="prose">
          <p>
            I'm a mechatronics engineering student at Helwan National University (graduating 2029) who builds software
            full-time. I like owning a product end to end: the interface, the API, the AI pipeline, the server it runs on,
            and even the videos that bring in the first users.
          </p>
          <p>
            I use AI coding tools heavily and check the work with tests. Arabic is my first language; I work in English
            (C1), and I speak German (B1) and some French (A2).
          </p>
        </div>
        <aside class="hardware" aria-labelledby="hw-title">
          <p class="label" id="hw-title">The hardware side</p>
          <ul>
            <li><strong>ConnectedLabs</strong> at Robotics Corner: remote SSH access to physical robots.</li>
            <li><strong>ROS 2 packages</strong> (CAN bridge, bring-up, simulation) for SparkX, a student autonomous-racing team. <a href="https://github.com/ahmed-codics/sparkx">Repo</a></li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section contact" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <p class="label">05 / Contact</p>
      <h2 id="contact-title">Hiring for a remote role? Let's talk.</h2>
      <CopyEmail size="lg" />
      <div class="cta">
        <a class="btn btn--primary" href={`mailto:${profile.email}`}><Icon name="mail" />Email me</a>
        <a class="btn" href={profile.linkedin}><Icon name="linkedin" />LinkedIn</a>
        <a class="btn" href={profile.github}><Icon name="github" />GitHub</a>
        <a class="btn" href={profile.cv}><Icon name="download" />CV (PDF)</a>
      </div>
      <p class="where">{profile.location} · {profile.timezone} · open to remote, full-time or contract.</p>
    </div>
  </section>
</Base>

<style>
  /* Hero on engineering graph paper */
  .hero { position: relative; isolation: isolate; overflow: hidden; }
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 24px 24px; background-position: -1px -1px;
    -webkit-mask-image: radial-gradient(ellipse 75% 85% at 78% 20%, #000 25%, transparent 72%);
    mask-image: radial-gradient(ellipse 75% 85% at 78% 20%, #000 25%, transparent 72%);
  }
  .hero-in {
    display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); align-items: center;
    padding-block: clamp(48px, 9vw, 104px) clamp(56px, 8vw, 96px);
  }
  .hero-text { display: grid; gap: 22px; min-width: 0; }
  .sheet { display: grid; gap: 0; min-width: 0; }
  .sheet-head {
    display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;
    padding: 10px 18px; border: 1px solid var(--line-strong); border-bottom: 0; border-radius: var(--radius) var(--radius) 0 0;
    background: var(--paper);
  }
  .sheet .spec { border-radius: 0 0 var(--radius) var(--radius); }
  .eyebrow { line-height: 1.7; }
  .dot { display: inline-block; vertical-align: 1px; width: 7px; height: 7px; margin-right: 10px; border-radius: 2px; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  h1 { max-width: 17ch; }
  .lead { max-width: 62ch; font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem); color: var(--ink-2); }
  .lead a { color: var(--ink); font-weight: 600; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; }


  /* Work cards */
  .card { border: 1px solid var(--line-strong); border-radius: 18px; background: var(--surface); padding: clamp(20px, 3.4vw, 36px); }
  .card + .card { margin-top: 18px; }
  .card-text { display: grid; gap: 14px; align-content: start; min-width: 0; }
  .card-text > p:not(.label):not(.links) { color: var(--ink-2); }
  .card--feature { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(24px, 4vw, 48px); align-items: center; background: var(--accent-soft); border-color: color-mix(in srgb, var(--accent) 28%, var(--line-strong)); }
  .feature-media { position: relative; padding: 0 0 48px 0; min-width: 0; }
  .feature-phone { position: absolute; right: -6px; bottom: 0; width: clamp(110px, 26%, 160px); }
  .card--split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 48px); align-items: center; }
  .card--flip > .card-text { order: 2; }
  .card--row { display: grid; gap: 8px; }
  .card--row p:not(.label) { color: var(--ink-2); }

  .ticks { list-style: none; display: grid; gap: 8px; font-size: var(--s-15); }
  .ticks li { position: relative; padding-left: 24px; }
  .ticks li::before {
    content: ''; position: absolute; left: 0; top: 0.42em; width: 13px; height: 7px;
    border-left: 2px solid var(--accent); border-bottom: 2px solid var(--accent); transform: rotate(-45deg);
  }

  .products { margin: 0; display: grid; border-top: 1px solid var(--line); }
  .products > div { display: grid; grid-template-columns: minmax(0, 9.5em) minmax(0, 1fr) auto; gap: 4px 14px; align-items: baseline; padding: 9px 0; border-bottom: 1px solid var(--line); font-size: var(--s-15); }
  .products dt { font-weight: 600; }
  .products dd { margin: 0; color: var(--ink-2); }
  .status { font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 7px; border-radius: 5px; border: 1px solid var(--line-strong); color: var(--muted) !important; }
  .status.live { color: var(--accent-ink) !important; border-color: color-mix(in srgb, var(--accent) 45%, transparent); background: var(--accent-soft); }

  /* Experience */
  .timeline { list-style: none; margin: 0; padding: 0; display: grid; }
  .timeline > li { display: grid; grid-template-columns: 13rem minmax(0, 1fr); gap: 8px 32px; padding-block: 22px; border-top: 1px solid var(--line); }
  .timeline > li:first-child { border-top: 0; padding-top: 0; }
  .when { padding-top: 4px; }
  .timeline h3 { font-size: var(--s-17); font-weight: 650; letter-spacing: -0.01em; }
  .org { font-weight: 500; color: var(--muted); }
  .org a { color: var(--ink-2); }
  .timeline ul { list-style: none; display: grid; gap: 6px; margin-top: 10px; color: var(--ink-2); font-size: var(--s-15); }
  .timeline ul li { position: relative; padding-left: 18px; }
  .timeline ul li::before { content: ''; position: absolute; left: 0; top: 0.75em; width: 8px; height: 2px; background: var(--accent); }
  .timeline .links { margin-top: 10px; }

  /* Skills */
  .skills { margin: 0; display: grid; border-top: 1px solid var(--line); }
  .skills > div { display: grid; grid-template-columns: 13rem minmax(0, 1fr); gap: 4px 32px; padding-block: 14px; border-bottom: 1px solid var(--line); }
  .skills dt { font-weight: 600; }
  .skills dd { margin: 0; color: var(--ink-2); }

  /* About */
  .about-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 64px); align-items: start; }
  .about-grid .prose p { max-width: 62ch; }
  .hardware { border: 1px dashed var(--line-strong); border-radius: var(--radius); padding: 18px 20px; display: grid; gap: 10px; font-size: var(--s-15); color: var(--ink-2); }
  .hardware ul { list-style: none; display: grid; gap: 10px; }
  .hardware strong { color: var(--ink); font-weight: 600; }
  .hardware a { color: var(--accent-ink); font-weight: 600; }

  /* Contact */
  .contact .wrap { display: grid; gap: 18px; justify-items: start; }
  .contact h2 { font-size: clamp(1.75rem, 1.3rem + 2vw, 2.5rem); max-width: 20ch; }
  .where { color: var(--muted); font-size: var(--s-15); }

  @media (max-width: 900px) {
    .hero-in { grid-template-columns: minmax(0, 1fr); }
    .card--feature, .card--split { grid-template-columns: minmax(0, 1fr); }
    .card--flip > .card-text { order: 0; }
    .feature-media { order: -1; }
    .about-grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .timeline > li, .skills > div { grid-template-columns: minmax(0, 1fr); }
    .products > div { grid-template-columns: minmax(0, 1fr) auto; }
    .products dd:not(.status) { grid-column: 1 / -1; grid-row: 2; }
    .feature-phone { right: 0; }
  }
</style>

---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
interface Props { size?: 'md' | 'lg' }
const { size = 'md' } = Astro.props;
---
<div class:list={['copy-email', size]}>
  <a class="addr" href={`mailto:${profile.email}`}>{profile.email}</a>
  <button class="btn btn--sm" type="button" data-copy={profile.email}>
    <Icon name="copy" /><span>Copy</span>
  </button>
  <span class="sr-only" role="status" aria-live="polite"></span>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy || '';
      const label = btn.querySelector('span');
      const status = btn.parentElement?.querySelector('[role=status]');
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const a = btn.parentElement?.querySelector('.addr');
        if (a) getSelection()?.selectAllChildren(a);
        return;
      }
      if (label) label.textContent = 'Copied';
      if (status) status.textContent = 'Email address copied';
      setTimeout(() => { if (label) label.textContent = 'Copy'; if (status) status.textContent = ''; }, 2000);
    });
  });
</script>

<style>
  .copy-email { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; min-width: 0; }
  .addr { font-family: var(--mono); font-size: var(--s-15); color: var(--ink); overflow-wrap: anywhere; }
  .lg .addr { font-size: clamp(1rem, 0.85rem + 0.8vw, 1.375rem); font-weight: 500; }
</style>
